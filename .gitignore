# Shared ignore rules for the whole repo.
# Each template keeps its own .gitignore so it still works when copied out on its own.

# OS
.DS_Store

# IDE
.vscode/

# Agentic AI related
.claude/
.agent/

# Local working folders
docs/dev/
deprecated/
stored/
references/
reference/
tmp/
mock_data/

# Safety net for every template
node_modules/
.env
.env.*
!.env.example
