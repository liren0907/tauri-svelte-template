# Copy to `.env` to override the defaults during local development.
# In containers and cloud platforms, set these as real environment variables.

# Address to bind. Use 0.0.0.0 inside containers.
HOST=127.0.0.1

# Port to listen on.
PORT=8080

# Comma-separated browser origins allowed to call the API (CORS).
# Defaults cover the Vite dev server and the Tauri desktop webview.
CORS_ALLOWED_ORIGINS=http://localhost:1430,tauri://localhost,http://tauri.localhost

# Log level, e.g. info, debug, or backend=debug,tower_http=info
RUST_LOG=info
