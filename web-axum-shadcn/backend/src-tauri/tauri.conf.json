{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "web-axum-shadcn",
  "version": "0.1.0",
  "identifier": "com.example.web-axum-shadcn",
  "build": {
    "frontendDist": "../../frontend/build",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "cd ../frontend && yarn dev:stack",
    "beforeBuildCommand": "cd ../frontend && yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "Notes — Axum + shadcn-svelte",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
